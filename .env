# ---------- InfluxDB ----------
INFLUXDB_USERNAME=me
INFLUXDB_PASSWORD=123123123
INFLUXDB_ORG=sk
INFLUXDB_BUCKET=telegraf
INFLUXDB_ADMIN_TOKEN=123

# ---------- Grafana ----------
GRAFANA_ADMIN_PASSWORD=123
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_OAUTH_CLIENT_ID=grafana
GRAFANA_OAUTH_CLIENT_SECRET=grafana-secret

# ---------- Keycloak ----------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=Viewer
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/${KEYCLOAK_REALM}
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/realms/${KEYCLOAK_REALM}

# ---------- MongoDB ----------
MONGO_URL=mongodb://mongo:27017

# ---------- Ethereum collector ----------
ETH_COLLECTOR_POLL_INTERVAL=30

# ---------- RustFS ----------
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=123
RUSTFS_BUCKET=test-bucket

# ---------- Polaris ----------
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=change-me
POLARIS_OIDC_CLIENT_ID=polaris-client
POLARIS_OIDC_CLIENT_SECRET=change-me
POLARIS_CATALOG_NAME=poc-catalog

# ---------- Polaris metadata database ----------
POLARIS_DB_NAME=POLARIS
POLARIS_DB_USER=polaris
POLARIS_DB_PASSWORD=123

# ---------- Spark sync job ----------
SYNC_INTERVAL_SECONDS=300